# Copy to .env (gitignored). All optional.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # hosted Postgres (Neon); unset -> bundled postgres
# FRONTEND_PORT=5173
# BACKEND_PORT=8000

# Public access for a Vercel-hosted frontend
# CLOUDFLARE_TUNNEL_TOKEN=      # named tunnel: docker compose --profile public up -d
# VERCEL_ORIGIN=https://your-app.vercel.app
