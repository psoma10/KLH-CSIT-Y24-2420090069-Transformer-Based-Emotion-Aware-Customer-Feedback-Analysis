# Copy to backend/.env for local (non-Docker) development. All defaults
# below match app/core/config.py's Settings field defaults.

# Model
MODEL_DIR=../ml/artifacts/model-v1
MODEL_MAX_LENGTH=128
SHAP_MAX_EVALS=200
SHAP_CACHE_TTL_SECONDS=604800

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/emotion_feedback

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# App
MODEL_VERSION=model-v1
API_V1_PREFIX=/api
